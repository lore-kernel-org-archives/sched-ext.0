+
+	/* flags sub-tests */
+	} else if (strcmp(testname, "flags_psh") == 0) {
+		correct_payload[0] = PAYLOAD_LEN * 3;
+		correct_payload[1] = PAYLOAD_LEN * 2;
+		printf("psh flag ends coalescing: ");
