+static bool dc_is_rmcm_3dlut_supported(struct hubp *hubp, struct mpc *mpc)
+{
+	if (mpc->funcs->rmcm.power_on_shaper_3dlut &&
+		mpc->funcs->rmcm.fl_3dlut_configure &&
+		hubp->funcs->hubp_program_3dlut_fl_config)
+		return true;
+
+	return false;
+}
