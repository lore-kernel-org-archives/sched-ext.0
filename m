+		break;
+	case 2:
+		REG_UPDATE(OTG_ADD_DROP_PIXEL_CNTL,
+				OTG2_ADD_PIXEL, 1);
+		break;
+	case 3:
+		REG_UPDATE(OTG_ADD_DROP_PIXEL_CNTL,
+				OTG3_ADD_PIXEL, 1);
+		break;
+	default:
+		ASSERT(0);
+	}
