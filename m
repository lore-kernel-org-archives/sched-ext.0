+	 * That in fact means >= 76, since 74 mod 4 == 2\
+	 */						\
+	r7 <<= 2;					\
+	r7 += 76;					\
+	/* Add it to the packet pointer */		\
+	r5 += r7;					\
+	/* Check bounds and perform a read */		\
+	r4 = r5;					\
+	r4 += 4;					\
+	if r3 >= r4 goto l0_%=;				\
+	exit;						\
+l0_%=:	r6 = *(u32*)(r5 + 0);				\
+	exit;						\
